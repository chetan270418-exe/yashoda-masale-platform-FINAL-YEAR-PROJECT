# Copy to .env and fill in. NEVER commit .env.
POSTGRES_DB=yashoda_masale
POSTGRES_USER=yashoda_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
API_PORT=8000

# Used when running the backend outside Docker (backend/.env)
DATABASE_URL=postgresql+psycopg://yashoda_dev:local_dev_only@localhost:5432/yashoda_masale
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=local

# Auth / JWT
# Must be set to a strong random value outside the local environment.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login rate limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Only trust X-Forwarded-For when running behind a proxy you control.
# Leaving this false stops a client spoofing its IP to bypass the limiter.
TRUST_PROXY_HEADERS=false

# LLM provider (Decision D-010).
# The API key lives only in your local .env, never in the repo and never in
# the frontend (Rule 33).
#
#   mock         deterministic offline adapter, no network calls (default)
#   gemini       Google Gemini, native API
#   openai       OpenAI
#   groq         Groq, OpenAI-compatible, free tier
#   openrouter   OpenRouter, OpenAI-compatible
#   mistral      Mistral, OpenAI-compatible
#   together     Together AI, OpenAI-compatible
#   deepseek     DeepSeek, OpenAI-compatible
LLM_PROVIDER=mock
LLM_API_KEY=

# Only needed to override the provider's default base URL, or to point the
# adapter at a self-hosted or proxied endpoint.
LLM_BASE_URL=

# Optional. Defaults to a sensible model for the chosen provider.
LLM_MODEL=

LLM_TIMEOUT_SECONDS=15
