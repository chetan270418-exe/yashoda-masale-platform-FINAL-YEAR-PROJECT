# Copy to .env and fill in. NEVER commit .env.
POSTGRES_DB=yashoda_masale
POSTGRES_USER=yashoda_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
API_PORT=8000

# Used when running the backend outside Docker (backend/.env)
DATABASE_URL=postgresql+psycopg://yashoda_dev:local_dev_only@localhost:5432/yashoda_masale
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=local

# Placeholders for later milestones (leave empty until needed; keep real values only in your local .env)
JWT_SECRET=
LLM_PROVIDER=
LLM_API_KEY=
